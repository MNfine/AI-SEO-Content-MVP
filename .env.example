# Application
APP_ENV=development
DATABASE_URL=sqlite:///./ai_seo_content.db
REQUEST_TIMEOUT=30

# Gemini
# Leave GEMINI_API_KEY empty to use local fallback content.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_STRICT_ERRORS=false

# WordPress
# Set WORDPRESS_MOCK_PUBLISH=true for local/demo mode.
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
WORDPRESS_MOCK_PUBLISH=true
